# Telegram Bot Token (получить в @BotFather)
BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz

# Telegram ID главного администратора (получить в @userinfobot)
ADMIN_ID=123456789

# Подключение к PostgreSQL базе данных (для Docker Compose)
DATABASE_URL=postgresql+asyncpg://log_user:log_pass@db:5432/log_db

# Начальный баланс попыток для нового пользователя
START_ATTEMPTS=3

# Бонус попыток за приглашенного друга
REFERRAL_BONUS=1

# Интеграция с ЮKassa (для приема платежей)
YOOKASSA_SHOP_ID=123456
YOOKASSA_SECRET_KEY=live_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Стоимость подписки в копейках (10000 = 100 руб, 17000 = 170 руб)
PRICE_30_DAYS=10000
PRICE_60_DAYS=17000

# Интервал автоматической проверки статуса платежей (в секундах)
PAYMENT_CHECK_INTERVAL=30

